NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/remit2nepal
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
DEFAULT_SUPER_ADMIN_USER_ID=superadmin
DEFAULT_SUPER_ADMIN_PASSWORD=change-this-password
DEFAULT_SUPER_ADMIN_NAME=Super Administrator
NRB_API_URL=https://www.nrb.org.np/api/forex/v1/rates
NRB_API_KEY=
NRB_TIMEOUT_MS=15000
NRB_RETRY_COUNT=3
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE_MB=10
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=8
